// Configuração da Cloudflare.
// - As páginas desta pasta são servidas como site estático.
// - O worker.js responde só em /api/* (rastreamento e painel).
// - O banco de eventos (D1) é criado sozinho no primeiro deploy, porque não
//   tem "database_id" aqui. Depois de criado, a Cloudflare mantém o vínculo.
// - A senha do painel fica no segredo PAINEL_SENHA (Cloudflare > Workers >
//   cellive-skin-teste > Configurações > Variáveis e segredos).
{
  "name": "cellive-skin-teste",
  "compatibility_date": "2026-10-01",
  "main": "worker.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cellive-eventos"
    }
  ],
  "observability": {
    "enabled": true
  }
}
