{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "has": [{ "type": "host", "value": { "pre": "v2." } }], "destination": "/v2" }
  ],
  "functions": {
    "api/analise.js": { "maxDuration": 120 },
    "api/agente.js": { "maxDuration": 300, "includeFiles": "assets/js/quiz-perguntas.js" }
  },
  "headers": [
    { "source": "/api/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/painel", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/painel.html", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ]
}
